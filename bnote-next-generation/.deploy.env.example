#
# Local deploy config (copy to .deploy.env and keep it out of git)
#

# Whether deploy.sh should run ./build.sh first:
# true  -> build and deploy
# false -> deploy existing build output
DEPLOY_WITH_BUILD=true

# Build output folder created by build.sh --out (default: build)
BUILD_DIR=build

# Remote deployment target (DO NOT commit real value)
# Format: sftp://host/path
SFTP_URL=sftp://example.com/path/to/bnote-next-generation

# 1Password item that stores SFTP credentials (required for remote)
# Example references:
# op://Private/BNote SFTP/username
# op://Private/BNote SFTP/password
OP_USERNAME_REF=op://<vault>/<item>/username
OP_PASSWORD_REF=op://<vault>/<item>/password

# Sync .htaccess from a local file into both deploy targets
# (bnote-next-generation/.htaccess and bnote-next-generation/api/.htaccess)
# Recommended: keep enabled to avoid accidental deletion by mirror --delete.
DEPLOY_SYNC_HTACCESS=true

# Path to local .htaccess source file (absolute or relative to repo root).
# Usually generated automatically from DEPLOY_MAIL_CONFIG_SOURCE.
DEPLOY_HTACCESS_SOURCE=.deploy.htaccess

# Generate DEPLOY_HTACCESS_SOURCE from DEPLOY_MAIL_CONFIG_SOURCE before deploy.
# This keeps mail credentials in ONE place (.deploy.mail.php).
DEPLOY_SYNC_HTACCESS_FROM_MAIL=true

# Sync file-based mail config into api/config/mail.local.php in deploy bundle
# Recommended for shared hosting where SetEnv is not visible in PHP.
DEPLOY_SYNC_MAIL_CONFIG=true

# Path to local mail config source file (absolute or relative to repo root).
# This is the single source of truth for mail credentials.
DEPLOY_MAIL_CONFIG_SOURCE=.deploy.mail.php
